# Copied to /etc/floodwatch.env (root:floodwatch 0640) by setup.sh on first install. Fill in on the server only.
FLOODWATCH_DB=/var/lib/floodwatch/floodwatch.db
POLLER_ENABLED=1
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
# Your own LINE userId (Developers console > Basic settings > Your user ID): gets the monthly push-quota notices
OWNER_LINE_USER_ID=
B2B_API_KEYS=
