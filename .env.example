# Copy to .env and fill in. Never commit .env.

# api.nasa.gov key (EONET/CMR search work without it; DEMO_KEY is heavily rate-limited)
NASA_API_KEY=DEMO_KEY
# Earthdata Login bearer token - only needed to download granule files, not to search metadata
EARTHDATA_TOKEN=

# LINE Messaging API (LINE Developers console -> Messaging API channel)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Optional local sensor feed (JSON endpoint returning water-level readings)
LOCAL_SENSOR_BASE_URL=
LOCAL_SENSOR_API_KEY=

# B2B API key(s) for /v1/* endpoints, comma-separated
B2B_API_KEYS=

# Background rain poller + LINE push (1 = on). Without LINE_CHANNEL_ACCESS_TOKEN it runs dry (no sends).
POLLER_ENABLED=0
